    "analyze": "ANALYZE=true next build",
    "perf:test": "yarn test && yarn test:e2e",
    "perf:monitor": "ENABLE_PERFORMANCE_MONITORING=true yarn dev"
  },
  "dependencies": {
    "@prisma/client": "^5.16.1",
