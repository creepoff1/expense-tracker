    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "csv-parse": "^5.5.4",
    "csv-stringify": "^6.4.6",
    "lucide-react": "^0.363.0",
    "next": "14.2.5",
    "next-auth": "^4.24.7",
    "postcss": "^8.4.39",
    "prisma": "^5.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
